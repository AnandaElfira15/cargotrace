APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS=cargotrace@example.com
MAIL_FROM_NAME="CargoTrace"
# For real e-mails use SMTP (e.g. Mailtrap sandbox or Gmail app password):
# MAIL_MAILER=smtp
# MAIL_HOST=sandbox.smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=
# MAIL_PASSWORD=
# true = also e-mail important notifications (status, delay, exceptions). false = in-app only.
NOTIFY_BY_EMAIL=false

# ---- Group scenarios: ONE application serves Groups A, B and C at the same time ----
# Each shipment belongs to a trade lane with its own route, delay threshold, main exception and KPI:
#   Group A: Southeast Asia -> Europe,      12 h, CUSTOMS_HOLD,        on_time_delivery_rate
#   Group B: Asia -> North America,         18 h, WEATHER_DELAY,       average_delay_duration
#   Group C: Southeast Asia -> Australia,   24 h, DOCUMENTATION_ISSUE, exception_resolution_time
# The lanes are stored in the database (Settings page, admin) and created by the seeder.
# Seeder: all = A + B + C (default), or a / b / c for a single lane (see database/seeders/scenarios/).
GROUP_SCENARIO=all
GROUP_NAME="Groups A, B & C"
GROUP_ROUTE="SE Asia -> Europe, Asia -> N. America, SE Asia -> Australia"

# ---- Global delay thresholds (hours) for shipments WITHOUT a trade lane ----
# 0..LOW = LOW, LOW..MEDIUM = MEDIUM, above MEDIUM = HIGH. Lanes override these with their own values.
DELAY_LOW_MAX_HOURS=6
DELAY_MEDIUM_MAX_HOURS=24

# ---- External APIs ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OpenStreetMap usage policy asks for a contact address in requests
NOMINATIM_CONTACT_EMAIL=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Optional: only needed for a commercial Open-Meteo plan. Never commit a real key.
OPEN_METEO_API_KEY=
EXTERNAL_API_TIMEOUT=5

# ---- Demo data ----
DEMO_PASSWORD=password
