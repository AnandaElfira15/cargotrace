APP_NAME=CargoTrace
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cargotrace
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log

# ---- Group scenario (the lecturer gives every group different parameters) ----
# Demo data set: a, b or c  (see database/seeders/scenarios/). Copy one to create your own.
#   Group A: Southeast Asia -> Europe,      12 h, CUSTOMS_HOLD,        on_time_delivery_rate
#   Group B: Asia -> North America,         18 h, WEATHER_DELAY,       average_delay_duration
#   Group C: Southeast Asia -> Australia,   24 h, DOCUMENTATION_ISSUE, exception_resolution_time
GROUP_SCENARIO=a
GROUP_NAME="Group A"
GROUP_ROUTE="Southeast Asia to Europe"
# one of: on_time_delivery_rate | average_delay_duration | exception_resolution_time
GROUP_KPI=on_time_delivery_rate
GROUP_PRIMARY_EXCEPTION=CUSTOMS_HOLD
GROUP_SECONDARY_EXCEPTION=PORT_CONGESTION

# ---- Delay rules (hours). 0..LOW = LOW, LOW..MEDIUM = MEDIUM, above MEDIUM = HIGH ----
# DELAY_MEDIUM_MAX_HOURS is the group "delay threshold" (e.g. 12 / 18 / 24).
# Admins can also change both values in the app (Settings page); the database value wins.
DELAY_LOW_MAX_HOURS=6
DELAY_MEDIUM_MAX_HOURS=12

# ---- External APIs ----
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# OpenStreetMap usage policy asks for a contact address in requests
NOMINATIM_CONTACT_EMAIL=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
# Optional: only needed for a commercial Open-Meteo plan. Never commit a real key.
OPEN_METEO_API_KEY=
EXTERNAL_API_TIMEOUT=5

# ---- Demo data ----
DEMO_PASSWORD=password
