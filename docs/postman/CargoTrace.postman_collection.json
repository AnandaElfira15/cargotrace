    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "shipmentId",
      "value": "1"
    },
    {
      "key": "exceptionId",
      "value": "1"
    },
    {
      "key": "customerId",
      "value": "3"
    }
  ],
